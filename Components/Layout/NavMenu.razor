<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SH Member Portal</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/members">
            <span class="bi bi-plus-square-fill-nav-menu" aria-hidden=true></span> Add Members
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/manage">
                <span class="bi bi-dash-square-fill-nav-menu" aria-hidden="true"></span> Manage Members
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" data-enhance="false">
                        <button type="submit" class="nav-link btn btn-link p-0 text-start w-100" style="color:#d7d7d7; text-decoration:none;">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link" href="/login">Login</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
