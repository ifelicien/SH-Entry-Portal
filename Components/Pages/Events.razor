@* Page: Events — Form for adding a new sisterhood event *@
@page "/events"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SH_Entry_Portal.Models.Generated
@inject SH_Entry_Portal.Services.EventService EventService
@rendermode InteractiveServer

<EditForm Model="newEvent" OnValidSubmit="HandleAdd" FormName="addEvent">
    <DataAnnotationsValidator />
    <div class="form-header">
        <h3>Event Entry</h3>
        <p class="text-muted">Complete all required fields and submit to add a new event.</p>
    </div>

    <div class="card form-card">
        <div class="card-body">
            <h5 class="section-title">Event Details</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Event Name</label>
                    <input type="text" class="form-control" @bind="newEvent.Name" placeholder="Spring Gala" />
                    <ValidationMessage For="() => newEvent.Name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Location</label>
                    <input type="text" class="form-control" @bind="newEvent.Location" placeholder="Community Hall" />
                    <ValidationMessage For="() => newEvent.Location" />
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Date &amp; Time</label>
                    <input type="datetime-local" class="form-control" @bind="newEvent.EventTime" />
                    <ValidationMessage For="() => newEvent.EventTime" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block">Paid Event?</label>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" @bind="newEvent.IsPaid" id="isPaidCheck" />
                        <label class="form-check-label" for="isPaidCheck">@(newEvent.IsPaid ? "Paid" : "Free")</label>
                    </div>
                </div>
                @if (newEvent.IsPaid)
                {
                    <div class="col-md-3">
                        <label class="form-label">Price ($)</label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="newEvent.Price" />
                    </div>
                }
            </div>
            <div class="d-flex justify-content-end">
                <button class="btn btn-primary px-4" type="submit" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Submit")
                </button>
            </div>
        </div>
    </div>
</EditForm>

@if (submitted)
{
    <div class="alert alert-success">
        Success
    </div>
}

@code {
    // Supplies the logged-in admin's identity, used to attribute this submission in the audit log
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private Event newEvent = new() { EventTime = DateTime.Today.AddDays(7) };

    private bool submitted = false;
    private bool isSaving = false;

    private async Task HandleAdd()
    {
        isSaving = true;

        if (!newEvent.IsPaid)
        {
            newEvent.Price = null;
        }

        var authState = await AuthState!;
        var email = authState.User.Identity?.Name ?? "unknown";

        await EventService.AddEventAsync(newEvent, email);

        isSaving = false;
        submitted = true;
        newEvent = new() { EventTime = DateTime.Today.AddDays(7) };
    }
}
