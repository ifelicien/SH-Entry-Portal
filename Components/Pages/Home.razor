@* Page: Home — Portal landing page with quick navigation and status info *@
@page "/"
@using SH_Entry_Portal.Data
@inject AppDbContext DbContext
@rendermode InteractiveServer

@* Root: page content starts here — no wrapping layout div needed, MainLayout provides the shell *@
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Get Started</h2>
        <p class="mb-3">
            Start a new member submission using the entry form.
        </p>
        <a class="btn btn-primary" href="/members">Go to Member Entry</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Portal Status</h2>
                <p class="mb-1"><strong>App:</strong> Running</p>
                <p class="mb-1">
                    <strong>Database:</strong>
                    @if (isChecking)
                    {
                        <span class="text-muted">Checking...</span>
                    }
                    else if (isDatabaseOnline)
                    {
                        <span class="text-success">Online</span>
                    }
                    else
                    {
                        <span class="text-danger">Unreachable (may be paused)</span>
                    }
                </p>
                <p class="mb-2"><strong>Last checked:</strong> @lastChecked</p>
                <button class="btn btn-sm btn-outline-secondary" disabled="@isChecking" @onclick="CheckDatabaseStatus">
                    @(isChecking ? "Checking..." : "Refresh")
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Validation Notes</h2>
                <ul class="mb-0">
                    <li>Required fields must be completed.</li>
                    <li>Email format is validated.</li>
                    <li>Phone format is validated.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6">Quick Steps</h2>
        <ol class="mb-0">
            <li>Open Member Entry.</li>
            <li>Complete required fields.</li>
            <li>Submit and confirm success.</li>
        </ol>
    </div>
</div>

<p class="small text-muted mb-0">
    S.H. webportal v0.1. Contact the portal admin for data corrections.
</p>

@code {
    private bool isDatabaseOnline = false;
    private bool isChecking = true;
    private string lastChecked = "Never";

    protected override async Task OnInitializedAsync()
    {
        await CheckDatabaseStatus();
    }

    private async Task CheckDatabaseStatus()
    {
        isChecking = true;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            isDatabaseOnline = await DbContext.Database.CanConnectAsync(cts.Token);
        }
        catch
        {
            isDatabaseOnline = false;
        }

        lastChecked = DateTime.Now.ToString("f");
        isChecking = false;
    }
}