@page "/manage"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SH_Entry_Portal.Models.Generated
@using SH_Entry_Portal.Services

@inject SH_Entry_Portal.Services.MemberService memberService
@rendermode InteractiveServer

<div class="manage-page">
    <div class="manage-header">
        <h3>Manage Members</h3>
        <p class="text-muted">Search for a member to edit, or view all records below.</p>
    </div>

    @* --- Autocomplete search --- *@
    <div class="search-wrapper mb-3">
        <input type="text" class="form-control" placeholder="Search by name..." @bind="searchText" @bind:event="oninput" />
        @if (FilteredMembers.Any())
        {
            <ul class="suggestion-list">
                @foreach (var m in FilteredMembers)
                {
                    <li @onclick="() => SelectMember(m)">@m.FirstName @m.LastName</li>
                }
            </ul>
        }
    </div>

    @* --- Inline edit form shown when a member is selected --- *@
    @if (selectedMember != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="section-title">Editing: @selectedMember.FirstName @selectedMember.LastName</h5>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <input type="text" class="form-control" @bind="selectedMember.FirstName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <input type="text" class="form-control" @bind="selectedMember.LastName" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="text" class="form-control" @bind="selectedMember.Email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" @bind="selectedMember.Phone" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Role</label>
                        <InputSelect class="form-select" @bind-Value="selectedMember.Role">
                            <option value="Member">Member</option>
                            <option value="Officer">Officer</option>
                            <option value="President">President</option>
                            <option value="VicePresident">Vice President</option>
                            <option value="Secretary">Secretary</option>
                            <option value="Treasurer">Treasurer</option>
                            <option value="Chaplain">Chaplain</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-select" @bind-Value="selectedMember.Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Pending">Pending</option>
                            <option value="Honorary">Honorary</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Joined On</label>
                        <input type="date" class="form-control" @bind="selectedMember.JoinedOn" />
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="() => selectedMember = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveEdit">Save</button>
                </div>
            </div>
        </div>
    }

    @if (memberService.GetMembers().Count == 0)
    {
        <div class="alert alert-info">No members added yet.</div>
    }
    else
    {
        <div class="card manage-card">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in memberService.GetMembers())
                        {
                            <tr>
                                <td @onclick="() => SelectMember(member)" style="cursor: pointer;">@member.FirstName @member.LastName</td>
                                <td @onclick="() => SelectMember(member)" style="cursor: pointer;">@member.Email</td>
                                <td @onclick="() => SelectMember(member)" style="cursor: pointer;">@member.Phone</td>
                                <td @onclick="() => SelectMember(member)" style="cursor: pointer;">@FormatRole(member.Role)</td>
                                <td class="@(member.Status == MemberStatus.Inactive ? "status-inactive" : "")">@member.Status</td>
                                <td>
                                    @if(member.Status == MemberStatus.Active){
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => SetInactive(member)">Set Inactive</button>
                                    }
                                    else{
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => SetActive(member)">Set Active</button>

                                    }

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code{
    private Member? selectedMember = null;

    private void SelectMember(Member m)
    {
        selectedMember = m;
        searchText = "";
    }

    private void SetInactive(Member m){
        m.Status = MemberStatus.Inactive;
        memberService.SaveChanges();
    }

    private void SetActive(Member m){
        m.Status = MemberStatus.Active;
        memberService.SaveChanges();
    }

    private void SaveEdit()
    {
        memberService.SaveChanges();
        selectedMember = null;
    }

    // Displays "Vice President" instead of the raw enum member name "VicePresident"
    private string FormatRole(MemberRole role) =>
        role == MemberRole.VicePresident ? "Vice President" : role.ToString();

    private string searchText = "";

    public List<Member> FilteredMembers =>
        searchText.Length < 2 ? new List<Member>() :
        memberService.GetMembers()
        .Where(m => m.FirstName.Contains(searchText,StringComparison.OrdinalIgnoreCase) || m.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) 
        .ToList();
}